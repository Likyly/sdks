{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "tag-separator": "-",
  "bump-minor-pre-major": true,
  "packages": {
    "typescript": { "release-type": "node", "component": "typescript", "package-name": "@likyly/sdk", "extra-files": ["src/version.ts"] },
    "react":      { "release-type": "node", "component": "react", "package-name": "@likyly/react" },
    "mcp":        { "release-type": "node", "component": "mcp", "package-name": "@likyly/mcp-server", "extra-files": ["src/tools.ts"] },
    "python":     { "release-type": "simple", "component": "python", "package-name": "likyly", "extra-files": ["src/likyly/_version.py"] },
    "php":        { "release-type": "simple", "component": "php", "package-name": "likyly/sdk", "extra-files": ["src/Version.php"] },
    "laravel":    { "release-type": "simple", "component": "laravel", "package-name": "likyly/laravel" },
    "dotnet":     { "release-type": "simple", "component": "dotnet", "package-name": "Likyly", "extra-files": ["src/Likyly/Likyly.csproj", "src/Likyly/LikylyClient.cs"] },
    "java":       { "release-type": "simple", "component": "java", "package-name": "com.likyly:likyly-sdk", "extra-files": ["pom.xml", "src/main/java/com/likyly/Likyly.java"] },
    "go":         { "release-type": "simple", "component": "go", "package-name": "github.com/likyly/likyly-go", "extra-files": ["version.go"] },
    "ruby":       { "release-type": "simple", "component": "ruby", "package-name": "likyly", "extra-files": ["lib/likyly/version.rb"] },
    "rust":       { "release-type": "rust", "component": "rust", "package-name": "likyly" }
  }
}
