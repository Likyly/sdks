{
    "name": "likyly/sdk",
    "description": "Product recommendations for your PHP site (\"You may also like\", \"Recommended for you\"), learned from what your visitors do. Official LIKYLY SDK.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://likyly.com/docs/sdk/php",
    "support": {
        "source": "https://github.com/Likyly/likyly-php",
        "issues": "https://github.com/Likyly/sdks/issues",
        "docs": "https://likyly.com/docs/sdk/php"
    },
    "keywords": ["recommendations", "product recommendations", "recommender", "personalization", "e-commerce", "you may also like", "likyly"],
    "authors": [{ "name": "LIKYLY", "homepage": "https://www.likyly.com" }],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "squizlabs/php_codesniffer": "^3.10",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": { "Likyly\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Likyly\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "analyse": "phpstan analyse -c phpstan.neon"
    },
    "config": { "sort-packages": true }
}
